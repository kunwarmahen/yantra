# Copy to `.env` and fill in. Run with:  uv run yantra
# (.env is gitignored -- never commit real keys.)

# ---- Which provider bare `uv run yantra` uses ------------------------------
# Unset, it is worked out: whichever API key is present (Anthropic, then
# OpenAI, then Responses), and failing that an OLLAMA_* line below -- the
# local road has no key to find, so writing one of those down is how a
# keyless setup says what it meant. Set this to end the question outright.
# YANTRA_PROVIDER=local                                 # anthropic|openai|responses|ollama
#                                                       # "local" is another word
#                                                       # for "ollama" -- same road

# ---- Anthropic dialect ----------------------------------------------------
# Works against the Anthropic API directly or any gateway speaking its dialect.
# BASE_URL EXCLUDES the version segment; the adapter appends /v1/messages.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com          # direct
# ANTHROPIC_BASE_URL=https://openrouter.ai/api          # OpenRouter
ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_CONTEXT_WINDOW=200000                        # default (auto-compaction math)

# Some environments export ANTHROPIC_AUTH_TOKEN instead of ANTHROPIC_API_KEY;
# load_settings() falls back to it.

# ---- OpenAI dialect -------------------------------------------------------
# BASE_URL INCLUDES /v1; the adapter appends /chat/completions.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1             # direct
# OPENAI_BASE_URL=https://openrouter.ai/api/v1          # OpenRouter
OPENAI_MODEL=gpt-4o-mini
# OPENAI_CONTEXT_WINDOW=200000                           # default (auto-compaction math)

# ---- OpenAI Responses API (third dialect) ----------------------------------
# Chat-completions' successor wire format. BASE_URL INCLUDES /v1; the adapter
# appends /responses. Works against OpenAI directly, OpenRouter (stateless
# beta), or a local Ollama >= 0.13.3 (which serves /v1/responses too).
RESPONSES_API_KEY=
# RESPONSES_BASE_URL=https://api.openai.com/v1           # direct
# RESPONSES_BASE_URL=https://openrouter.ai/api/v1        # OpenRouter (beta)
# RESPONSES_BASE_URL=http://localhost:11434/v1           # local Ollama
RESPONSES_MODEL=gpt-4o-mini                             # e.g. openai/gpt-4o-mini on OpenRouter
# RESPONSES_CONTEXT_WINDOW=200000                        # default (auto-compaction math)

# ---- Local models (Ollama) -------------------------------------------------
# No key needed. `ollama pull <tag>` first, then:  uv run yantra --provider local
# Uncomment either line below and bare `uv run yantra` goes local too, with
# no --provider flag: a tag or URL typed by hand is a declaration. A cloud
# key, if you also have one, still wins -- YANTRA_PROVIDER=local beats both.
# OLLAMA_BASE_URL=http://localhost:11434/v1             # default
# OLLAMA_MODEL=qwen3.8:latest                           # default; any pulled tag
# OLLAMA_CONTEXT_WINDOW=8192                            # default (auto-compaction math)
# OLLAMA_API_KEY=                                       # only for proxies in front of Ollama

# ---- Cost accounting (/usage and the turn footer show $) --------------------
# Optional JSON file of list prices in USD per 1M tokens, overriding or
# extending the built-in snapshot (which covers current Claude + GPT slugs).
# Exact keys match one slug; a trailing * is a family-prefix rule.
# YANTRA_PRICES=/path/to/prices.json
# {"my-model": {"input": 3.0, "output": 15.0},
#  "vendor/slug*": {"input": 1.0, "output": 2.0, "cached_read": 0.1}}

# ---- Tools ------------------------------------------------------------------
# Past ~20 registered tools the harness sends only the K best-matching ones
# each turn. This backs --tool-select: K forces that width every session,
# 0 turns selection off, unset lets it auto-enable at 12.
# YANTRA_TOOLS_PER_TURN=12

# Hide tools completely -- never sent, never executed, never suggested by
# list_available_tools. Comma-separated glob patterns on tool names; handy
# for trimming a family or a whole MCP server.
# YANTRA_DISABLED_TOOLS=browser_open,browser_click,browser_fill,browser_close
# YANTRA_DISABLED_TOOLS=mcp__slack__*,web_fetch

# ---- Browser logins ----------------------------------------------------------
# Let the browser_* tools stay logged in between sessions. Point this at a
# directory and the browser keeps its cookies there; leave it unset and each
# session starts fresh (the default). To log in ONCE by hand:
#   uv run yantra --browse-login https://site.com/login
# opens a VISIBLE window -- you sign in (2FA/captchas are yours to beat),
# close the window, done. Every later session starts signed-in. CLOSING THE
# WINDOW is what writes the session to disk; Ctrl-C is not the same thing.
# The command tells you what landed ("profile saved -- 47 cookies", or
# "nothing was saved"), so you never have to guess.
#
# Three cautions: the profile's cookies are encrypted with a key derived from
# a published constant -- deliberately, so this works on a server with no
# keyring (notes/59) -- which means treat them as session tokens in the clear:
# keep the profile outside any git repo -- Chromium locks the directory while in use, so one
# browser per profile at a time -- and if your browser is a SNAP, keep this
# path out of hidden (dot) directories: snap confinement cannot write into
# them and does not say so, it just saves nothing. Visible path below.
# YANTRA_BROWSER_PROFILE=~/yantra-browser-profile

# ---- Which browser ----------------------------------------------------------
# Unset, the browser_* tools drive Playwright's own bundled Chromium -- whose
# default build is the headless SHELL, announcing "HeadlessChrome" in its
# user-agent and carrying no codecs, no Widevine and no Google API keys. Sites
# that check for robots notice, and sign-in pages (Google among them) refuse it
# outright however visible the window is.
#
# Name a Chromium-family browser you already have and both problems go away:
# the agent drives it, and --browse-login runs it as a PLAIN SUBPROCESS with no
# automation attached at all -- which is the only form those sign-in pages
# accept. Either a channel Playwright knows by name, or a path:
#   chromium chrome chrome-beta chrome-dev chrome-canary msedge msedge-beta ...
# Use the SAME value for both: a profile belongs to the browser that wrote it,
# and Chromium refuses one stamped by a newer version of itself.
# YANTRA_BROWSER_EXECUTABLE=chrome
#
# ...or the path itself, if the channel name does not find it (a snap, a
# flatpak, a second install, a non-Linux box):
# YANTRA_BROWSER_EXECUTABLE=/usr/bin/google-chrome      # Chrome, .deb/.rpm
# YANTRA_BROWSER_EXECUTABLE=/snap/bin/brave             # Brave, snap
# YANTRA_BROWSER_EXECUTABLE=/usr/bin/chromium           # Chromium, distro pkg
# YANTRA_BROWSER_EXECUTABLE=/usr/bin/microsoft-edge     # Edge
# macOS: "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# A bare command is looked up on $PATH too, so `brave` works if it is there.

# Run the browser WITH a window instead of headless. Headless is a different
# Chromium build with its own fingerprints, and no flag talks it out of them;
# a headed browser has nothing to hide. With no display attached (a server, or
# an agent run you would rather not watch), Yantra starts an Xvfb -- a real X
# server with no monitor -- and gives it to the browser alone, so the window
# exists and nobody sees it. Needs xvfb installed; costs a process and memory.
# YANTRA_BROWSER_HEADED=1

# When the browser closes on its own. 'turn' (default): as every turn ends, so
# no window is left open after an answer. A number of seconds (e.g. 300): the
# page stays for your next turn ("now click the cheapest one") and closes once
# nothing has used it that long. 'model': never on its own -- only when the
# model calls browser_close, or Yantra exits. Logins live in the profile either
# way.
# YANTRA_BROWSER_CLOSE=300

# How the agent hands you a page when a step is yours -- paying for the flight
# it found, or a sign-in it cannot do (2FA, a captcha). 'window': the page opens
# in your own browser (or, for a sign-in, a window on the agent's profile that
# it waits for you to close). 'link': nothing opens; you get the address in the
# answer -- the only choice that works in a container or on a server. 'off': the
# agent is not offered the tool. Unset: 'window' with a screen, 'link' without.
# YANTRA_BROWSER_HANDOFF=link

# How long a browser launch waits for a profile another Yantra has open (say,
# your web page keeps it while a scheduled run starts). Default: 10 seconds
# with a person in front of it, 120 for an unattended run; then it says which
# process holds the profile. Give scheduled runs a profile of their own if
# your web page keeps its browser open all day.
# YANTRA_BROWSER_WAIT=30

# Nobody in front of this run -- set by a program that starts Yantra on a
# schedule (the same as --unattended). Writes not allowed ahead of time with
# --allow-tools are refused, a question ends the turn, and a browser handoff
# opens nothing; --json reports what the run needed a person for.
# YANTRA_UNATTENDED=1

# ---- Your accounts, through Setu --------------------------------------------
# Setu (github.com/kunwarmahen/setu) keeps your sign-ins -- Gmail, Home
# Assistant, Amazon, X -- and Yantra connects each Setu connection at startup,
# announced in one line: an MCP server each, or for a site with no API (Amazon,
# X) its own browser tools on the profile you signed in to (notes/112). Tools
# are classed by Setu's manifest (reads run, writes ask).
#   auto (default)  use Setu if it is installed here or on PATH; else silence
#   on              use it, and refuse to start if it cannot be found
#   off             never look
#   /path/to/setu   the setu program to run (Setu usually lives in its own venv)
# The --setu [PATH] / --no-setu flags win over this. See notes/95.
# YANTRA_SETU=/home/you/setu/.venv/bin/setu

# ---- Environment awareness ---------------------------------------------------
# The agent starts each session knowing its surroundings instead of asking you.
#   full (default)  time/timezone, host, working dir -- PLUS your city from
#                   ONE keyless lookup to https://ipinfo.io. Your city then
#                   rides in every request sent to your LLM provider, and the
#                   agent is told to try its tools before asking you things
#                   ("what's the temperature?" just answers).
#   local           machine facts only; nothing leaves the machine beyond the
#                   conversation itself
#   off             nothing injected -- the ask-you-everything behavior
# Flip mid-session with /env (REPL) or the env chip (web UI); this var and
# --env-context set the STARTING level.
# YANTRA_ENV_CONTEXT=full                              # default

# ---- Skills ------------------------------------------------------------------
# Procedural knowledge you write down once: a folder with a SKILL.md, picked up
# only when the work calls for it. Nothing to configure to use them -- these
# roots are searched automatically, nearest first:
#   .yantra/skills/     private overrides (gitignored)
#   skills/              the set your repo commits
#   ~/.yantra/skills/   yours, on every project
# This var (and the repeatable --skills-dir) adds roots that win over all three.
# Colon-separated, like $PATH. See notes/30-skills.md.
# YANTRA_SKILLS_PATH=~/shared-skills:/opt/team-skills

# Skills you do NOT want this session -- comma-separated globs, matched against
# skill names. The twin of YANTRA_DISABLED_TOOLS: a disabled skill stays on
# disk and still shows in /skills marked [off], it just never reaches the model.
# Reversible mid-session with /skills on NAME.
# YANTRA_DISABLED_SKILLS=deploy-*,pr-review

# Learned skills: after a turn that solved something worth keeping (it
# finished, took 4+ tool calls, and will come up again), the agent writes the
# working steps down as a skill, runs its script once to test it, and shows
# you everything before saving. They land in their own folders, searched
# after the ones above:
#   ~/.yantra/skills/learned/      "you" -- every project
#   .yantra/skills/learned/        "this project" -- private, never committed
#   ask   (default) offer, and save only on a yes; needs you at the terminal
#         or the web page, so a piped one-shot run never offers
#   auto  save a draft whose test passed WITHOUT asking -- unattended runs only
#   off   never offer; /learn (or "save last turn" on the page) still works
# Same as --learn. See notes/96-solve-it-once.md.
# YANTRA_LEARN=ask

# ---- Memory of you ------------------------------------------------------------
# What the agent keeps about YOU -- not the project -- across every project
# and conversation: "lives near RDU", "uses uv, not pip". Up to twenty go into
# the prompt when a conversation starts; `remember` asks you before keeping
# anything, and /memory lists, adds, finds and forgets. See notes/100.
#   local (default for your own sessions)  one sqlite file,
#         ~/.local/state/yantra/memory.sqlite, word-overlap search
#   off   no memory at all
#   NAME  a store behind an MCP server of that name (connect it with
#         --mcp-config, or [[mcp]] in a package), e.g. smritikosh. notes/102
# Agent packages get memory only when their agent.toml says so; --eval never.
# Same as --memory.
# YANTRA_MEMORY=local

# Whose memories. Unset, your login name. With no identity there is no
# memory, and one identity never sees another's.
# YANTRA_USER=asha

# The look back when a conversation ends (/quit, /clear, /load, before
# compaction): one call to your own model proposes up to five facts about
# you, from what you said.
#   ask   (default) show them, keep only what you pick; a bare Enter keeps none
#   auto  keep them without asking -- says so at startup
#   off   never look (/remember still does)
# Same as --reflect. See notes/101.
# YANTRA_REFLECT=ask

# ---- Keys for MCP servers ------------------------------------------------------
# An MCP server's config can point at a variable instead of carrying its key,
# so the key lives here and never in mcp.json, agent.toml or a remembered
# server:
#   stdio:  "env":     {"SMRITIKOSH_API_KEY": "${SMRITIKOSH_API_KEY}"}
#   http:   "headers": {"Authorization": "Bearer ${DOCS_TOKEN}"}
# A variable that is not set stops that one server with an error naming it,
# rather than sending an empty key. Servers behind an OAuth login need no
# variable: `uv run yantra --mcp-login NAME` once. See notes/09.
# SMRITIKOSH_API_KEY=sk-smriti-...        # e.g. a Smritikosh memory store
